#!/usr/bin/env node
// A stand-in for the `claude` CLI that speaks the Claude Agent SDK's stdio
// protocol (stream-json in and out, control requests both ways), so the
// bridge's integration tests can run where no real CLI is installed — CI.
// Every frame shape below was recorded from claude 2.1.260 through a tee shim.
// The "model" is a handful of scripted behaviours keyed on the prompt text;
// nothing here talks to a network.
import { randomUUID } from 'node:crypto'
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join } from 'node:path'
import { createInterface } from 'node:readline'

const VERSION = '9.9.9 (Claude Code)'
const argv = process.argv.slice(2)

if (argv[0] === '--version') {
  process.stdout.write(`${VERSION}\n`)
  process.exit(0)
}
if (argv[0] === 'auth' && argv[1] === 'status') {
  process.stdout.write(
    `${JSON.stringify({ loggedIn: true, authMethod: 'claude.ai', apiProvider: 'firstParty', email: 'fake@example.com', subscriptionType: 'fake' })}\n`,
  )
  process.exit(0)
}

// ---- session state (survives --resume through a file, like the CLI's transcript) ----
const flag = (name) => {
  const eq = argv.find((a) => a.startsWith(`${name}=`))
  if (eq) return eq.slice(name.length + 1)
  const i = argv.indexOf(name)
  return i >= 0 ? argv[i + 1] : undefined
}
const sessionId = flag('--resume') ?? randomUUID()
const model = flag('--model') === 'default' || !flag('--model') ? 'claude-fake-1' : `claude-${flag('--model')}-fake`
const stateDir = join(tmpdir(), 'genoffice-fake-claude')
mkdirSync(stateDir, { recursive: true })
const stateFile = join(stateDir, `${sessionId}.json`)
const state = existsSync(stateFile)
  ? JSON.parse(readFileSync(stateFile, 'utf8'))
  : { remembered: null, contextChars: 0 }
const saveState = () => writeFileSync(stateFile, JSON.stringify(state))
// auto-compaction: the CLI fires at roughly two thirds of its window; the
// bridge pins the window through this variable in its compaction test
const compactWindow = Number(process.env.CLAUDE_CODE_AUTO_COMPACT_WINDOW ?? 967_000)
const tokens = (chars) => Math.round(chars / 2)

// ---- wire ----
const out = (frame) => process.stdout.write(`${JSON.stringify(frame)}\n`)
const pending = new Map()
let systemPrompt = ''
let postCompactHook = null
let toolNames = []
const request = (req) =>
  new Promise((resolve) => {
    const request_id = randomUUID()
    pending.set(request_id, resolve)
    out({ type: 'control_request', request_id, request: req })
  })
const mcp = (message) => request({ subtype: 'mcp_message', server_name: 'genoffice', message })

const turns = []
let running = false
let interrupted = false
let initialized = false
const sleep = (ms) => new Promise((r) => setTimeout(r, ms))

const rl = createInterface({ input: process.stdin })
rl.on('line', (line) => {
  if (!line.trim()) return
  let frame
  try {
    frame = JSON.parse(line)
  } catch {
    return
  }
  if (frame.type === 'control_response') {
    const id = frame.response?.request_id
    const resolve = pending.get(id)
    pending.delete(id)
    resolve?.(frame.response)
  } else if (frame.type === 'control_request') {
    void handleControl(frame)
  } else if (frame.type === 'user') {
    turns.push(frame.message)
    void pump()
  }
})
rl.on('close', () => {
  // the SDK closed our input: like the CLI, finish what is queued and leave
  const check = () => (running || turns.length ? setTimeout(check, 20) : process.exit(0))
  check()
})
process.on('SIGTERM', () => process.exit(0))

async function handleControl(frame) {
  const { request_id, request } = frame
  if (request.subtype === 'initialize') {
    systemPrompt = (request.systemPrompt ?? []).join('\n')
    postCompactHook = request.hooks?.PostCompact?.[0]?.hookCallbackIds?.[0] ?? null
    out({
      type: 'control_response',
      response: {
        subtype: 'success',
        request_id,
        response: {
          commands: [],
          agents: [],
          output_style: 'default',
          available_output_styles: ['default'],
          models: [],
          account: { email: 'fake@example.com', subscriptionType: 'fake', apiProvider: 'firstParty' },
          pid: process.pid,
          current_permission_mode: 'default',
          hooks_applied: true,
        },
      },
    })
    // the in-process MCP server the bridge registered: same handshake as the CLI
    await mcp({ method: 'initialize', params: { protocolVersion: '2025-11-25', capabilities: {}, clientInfo: { name: 'claude-code', version: VERSION } }, jsonrpc: '2.0', id: 0 })
    out({ type: 'control_request', request_id: randomUUID(), request: { subtype: 'mcp_message', server_name: 'genoffice', message: { jsonrpc: '2.0', method: 'notifications/initialized' } } })
    const list = await mcp({ method: 'tools/list', jsonrpc: '2.0', id: 1 })
    toolNames = (list?.response?.mcp_response?.result?.tools ?? []).map((t) => t.name)
    out({
      type: 'system',
      subtype: 'init',
      cwd: process.cwd(),
      session_id: sessionId,
      tools: ['Read', ...toolNames.map((n) => `mcp__genoffice__${n}`)],
      mcp_servers: [{ name: 'genoffice', status: 'connected' }],
      model,
      permissionMode: 'default',
      slash_commands: [],
      apiKeySource: 'none',
      claude_code_version: VERSION.split(' ')[0],
      output_style: 'default',
      plugins: [],
      capabilities: ['interrupt_receipt_v1'],
      uuid: randomUUID(),
    })
    out({ type: 'rate_limit_event', rate_limit_info: { status: 'allowed', rateLimitType: 'five_hour', utilization: 0.1 }, uuid: randomUUID(), session_id: sessionId })
    initialized = true
    void pump()
  } else if (request.subtype === 'interrupt') {
    interrupted = true
    out({ type: 'control_response', response: { subtype: 'success', request_id, response: { still_queued: [] } } })
  } else {
    out({ type: 'control_response', response: { subtype: 'success', request_id, response: {} } })
  }
}

async function pump() {
  if (running || !initialized) return
  running = true
  try {
    while (turns.length) await turn(turns.shift())
  } finally {
    running = false
  }
}

// ---- the "model" ----
function userText(message) {
  const c = message.content
  if (typeof c === 'string') return { text: c, hasImage: false }
  const text = c.filter((b) => b.type === 'text').map((b) => b.text).join('\n')
  return { text, hasImage: c.some((b) => b.type === 'image') }
}

const shout = (s) => (/UPPERCASE/.test(systemPrompt) ? s.toUpperCase() : s)

async function turn(message) {
  interrupted = false
  const { text, hasImage } = userText(message)
  state.contextChars += text.length
  if (tokens(state.contextChars) > compactWindow * 0.67) await compact()
  out({ type: 'system', subtype: 'status', status: 'requesting', session_id: sessionId, uuid: randomUUID() })

  const wanted = ['get_document_context', 'get_document_title'].filter(
    (n) => text.includes(n) && !/do not call any tool/i.test(text) && toolNames.includes(n),
  )
  let reply
  let count = null
  if (hasImage) reply = 'red'
  else if (wanted.length) reply = await runTools(wanted, text)
  else {
    const remember = text.match(/Remember the word (\S+?)\./)
    const recall = /w(hat|hich) word did I ask you to remember/i.test(text)
    const counting = text.match(/Count from 1 to (\d+)/)
    const exact = text.match(/Reply with exactly(?: the word)?: (\S+?)\.?(?:\s|$)/)
    if (remember) {
      state.remembered = remember[1]
      reply = 'OK'
    } else if (recall) {
      reply = state.remembered ?? 'I do not know'
      if (/followed by the word "sky"/.test(text)) reply += ' sky'
    } else if (counting) count = Number(counting[1])
    else if (exact) reply = exact[1]
    else reply = 'OK'
  }
  saveState()

  const msgId = `msg_fake_${randomUUID().slice(0, 8)}`
  const usage = (outTokens) => ({
    input_tokens: Math.max(1, tokens(text.length)),
    cache_creation_input_tokens: 0,
    cache_read_input_tokens: 0,
    output_tokens: outTokens,
  })
  out({ type: 'stream_event', event: { type: 'message_start', message: { id: msgId, type: 'message', role: 'assistant', model, content: [], stop_reason: null, usage: usage(1) } }, session_id: sessionId, parent_tool_use_id: null, uuid: randomUUID() })
  out({ type: 'stream_event', event: { type: 'content_block_start', index: 0, content_block: { type: 'text', text: '' } }, session_id: sessionId, parent_tool_use_id: null, uuid: randomUUID() })
  const delta = (t) =>
    out({ type: 'stream_event', event: { type: 'content_block_delta', index: 0, delta: { type: 'text_delta', text: t } }, session_id: sessionId, parent_tool_use_id: null, uuid: randomUUID() })

  if (count !== null) {
    // a long answer the user may stop: stream until interrupted
    let produced = ''
    for (let i = 1; i <= count && !interrupted; i++) {
      const piece = `${i}\n`
      produced += piece
      delta(piece)
      await sleep(40)
    }
    if (interrupted) {
      out({ type: 'user', message: { role: 'user', content: [{ type: 'text', text: '[Request interrupted by user]' }] }, parent_tool_use_id: null, session_id: sessionId, uuid: randomUUID() })
      out(result('error_during_execution', { is_error: true, stop_reason: null, num_turns: 1, result: produced, usage: usage(tokens(produced.length)), errors: [] }))
      return
    }
    reply = produced
  } else {
    reply = shout(reply)
    for (let i = 0; i < reply.length; i += 8) delta(reply.slice(i, i + 8))
  }
  out({ type: 'stream_event', event: { type: 'content_block_stop', index: 0 }, session_id: sessionId, parent_tool_use_id: null, uuid: randomUUID() })
  out({ type: 'stream_event', event: { type: 'message_delta', delta: { stop_reason: 'end_turn', stop_sequence: null }, usage: usage(tokens(reply.length)) }, session_id: sessionId, parent_tool_use_id: null, uuid: randomUUID() })
  out({ type: 'stream_event', event: { type: 'message_stop' }, session_id: sessionId, parent_tool_use_id: null, uuid: randomUUID() })
  out({ type: 'assistant', message: { id: msgId, type: 'message', role: 'assistant', model, content: [{ type: 'text', text: reply }], stop_reason: 'end_turn', usage: usage(tokens(reply.length)) }, parent_tool_use_id: null, session_id: sessionId, uuid: randomUUID() })
  out(result('success', { is_error: false, stop_reason: 'end_turn', num_turns: 1, result: reply, usage: usage(Math.max(1, tokens(reply.length))) }))
}

function result(subtype, extra) {
  return {
    type: 'result',
    subtype,
    duration_ms: 10,
    duration_api_ms: 8,
    total_cost_usd: 0,
    modelUsage: {},
    permission_denials: [],
    terminal_reason: subtype === 'success' ? 'completed' : 'aborted_streaming',
    session_id: sessionId,
    uuid: randomUUID(),
    ...extra,
  }
}

/** The tool loop: tool_use blocks, permission prompts (all at once, as the CLI does for read-only tools), MCP calls, then an answer from the results. */
async function runTools(names, text) {
  const uses = names.map((name) => ({ id: `toolu_fake_${randomUUID().slice(0, 12)}`, name }))
  for (const [i, use] of uses.entries()) {
    out({ type: 'stream_event', event: { type: 'content_block_start', index: i, content_block: { type: 'tool_use', id: use.id, name: `mcp__genoffice__${use.name}`, input: {} } }, session_id: sessionId, parent_tool_use_id: null, uuid: randomUUID() })
    out({ type: 'assistant', message: { id: `msg_fake_${randomUUID().slice(0, 8)}`, type: 'message', role: 'assistant', model, content: [{ type: 'tool_use', id: use.id, name: `mcp__genoffice__${use.name}`, input: {} }], stop_reason: null, usage: { input_tokens: 1, output_tokens: 1, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 } }, parent_tool_use_id: null, session_id: sessionId, uuid: randomUUID() })
  }
  const permissions = await Promise.all(
    uses.map((use) =>
      request({ subtype: 'can_use_tool', tool_name: `mcp__genoffice__${use.name}`, display_name: use.name, input: {}, permission_suggestions: [], tool_use_id: use.id }),
    ),
  )
  const outputs = []
  for (const [i, use] of uses.entries()) {
    const decision = permissions[i]?.response ?? {}
    if (decision.behavior !== 'allow') {
      outputs.push({ name: use.name, text: `Permission denied: ${decision.message ?? ''}` })
      continue
    }
    const call = await mcp({ method: 'tools/call', params: { name: use.name, arguments: decision.updatedInput ?? {}, _meta: { 'claudecode/toolUseId': use.id } }, jsonrpc: '2.0', id: 2 + i })
    const content = call?.response?.mcp_response?.result?.content ?? []
    let resultText = content.filter((b) => b.type === 'text').map((b) => b.text).join('\n')
    out({ type: 'user', message: { role: 'user', content: [{ tool_use_id: use.id, type: 'tool_result', content: [{ type: 'text', text: resultText }] }] }, parent_tool_use_id: null, session_id: sessionId, uuid: randomUUID() })
    // a persisted result: the note tells the model to Read the file — this model does
    const saved = resultText.match(/saved at (\S+?) —/)
    if (saved && existsSync(saved[1])) resultText = readFileSync(saved[1], 'utf8')
    outputs.push({ name: use.name, text: resultText })
  }
  const joined = outputs.map((o) => o.text).join('\n')
  const exact = text.match(/reply with exactly the word: (\S+?)\.?(?:\s|$)/i)
  if (exact) return exact[1]
  const codeWord = /code word/i.test(text) ? joined.match(/Code word: (\S+)/) : null
  if (codeWord) return codeWord[1]
  const words = joined.match(/(\d+) words/)
  const title = joined.match(/Title: ([^\n]+)/)
  const parts = []
  if (title) parts.push(`The document is titled "${title[1].trim()}"`)
  if (words) parts.push(`it has ${words[1]} words`)
  return parts.length ? `${parts.join(' and ')}.` : 'I read the document.'
}

/** Auto-compaction as the CLI announces it: the PostCompact hook first, then the boundary. */
async function compact() {
  const pre = tokens(state.contextChars)
  const summary = `Summary of the conversation so far (${pre} tokens folded).${state.remembered ? ` The user asked to remember the word ${state.remembered}.` : ''}`
  if (postCompactHook) {
    await request({ subtype: 'hook_callback', callback_id: postCompactHook, input: { session_id: sessionId, cwd: process.cwd(), hook_event_name: 'PostCompact', trigger: 'auto', compact_summary: summary } })
  }
  state.contextChars = Math.round(summary.length)
  out({ type: 'system', subtype: 'compact_boundary', uuid: randomUUID(), compact_metadata: { trigger: 'auto', pre_tokens: pre, post_tokens: tokens(state.contextChars), duration_ms: 5 }, session_id: sessionId })
  out({ type: 'user', message: { role: 'user', content: [{ type: 'text', text: `This session is being continued from a previous conversation. ${summary}` }] }, parent_tool_use_id: null, session_id: sessionId, uuid: randomUUID() })
}
