{
  "name": "@genoffice/ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Shared renderer UI components for the office apps (AI panel composer, icons); styling stays per-app via the shared class names",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./screentip.css": "./src/screentip.css",
    "./color-picker.css": "./src/color-picker.css",
    "./dropdown.css": "./src/dropdown.css",
    "./fonts/*": "./src/fonts/*",
    "./tod.css": "./src/tod/tod.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@genoffice/i18n": "*",
    "@genoffice/pptx-render": "*"
  }
}
